# systemd unit for running the bot directly on a VPS (no Docker).
# Install with:
#   sudo cp deploy/discordstreak.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now discordstreak
# Adjust User/WorkingDirectory if you cloned somewhere else.

[Unit]
Description=DiscordStreak - voice chat streak bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discordstreak
WorkingDirectory=/opt/discordstreak
EnvironmentFile=/opt/discordstreak/.env
ExecStart=/usr/bin/node src/index.js

Restart=always
RestartSec=10
# Give up only if it keeps dying: 5 failures within 5 minutes.
StartLimitBurst=5
StartLimitIntervalSec=300

StandardOutput=journal
StandardError=journal
SyslogIdentifier=discordstreak

# Hardening - the bot only ever needs to write its own database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/discordstreak/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
