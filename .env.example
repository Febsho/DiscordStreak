# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID of the bot
CLIENT_ID=your-application-id-here

# Optional: register slash commands instantly in a single guild while developing.
# Leave empty to register globally (can take up to an hour to appear).
GUILD_ID=

# Timezone used to decide when a "day" starts/ends (IANA name).
TIMEZONE=Europe/Berlin

# How many seconds a user must stay in a voice channel before the day counts.
MIN_SECONDS=60

# Count time spent in AFK channels / while server-deafened? (true|false)
COUNT_AFK=false

# Where the SQLite database lives.
DB_PATH=./data/streaks.sqlite
